# --- Cérebro (Claude) ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_USER_NAME=senhor

# --- Voz (ElevenLabs) ---
ELEVENLABS_API_KEY=
# ID da voz escolhida na biblioteca do ElevenLabs (estilo mordomo britânico, falando português)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Reconhecimento de fala ---
# tiny | base | small | medium | large-v3   (sem GPU: small; com GPU NVIDIA: medium ou large-v3)
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt

# --- Hotword ---
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# --- Introdução do primeiro comando do dia ---
# Use UM dos dois: arquivo local (mp3/wav/flac/ogg) OU uma faixa do Spotify
INTRO_AUDIO_FILE=assets/intro.mp3
INTRO_SPOTIFY_URI=
INTRO_SECONDS=15

# --- Spotify (https://developer.spotify.com/dashboard, Redirect URI: http://127.0.0.1:8888/callback) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
