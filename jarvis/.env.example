# --- Cérebro (Claude) ---
ANTHROPIC_API_KEY=
# Mais rápido: claude-haiku-4-5 | equilibrado: claude-sonnet-5-5 | mais capaz (e mais lento): claude-opus-5-5
JARVIS_MODEL=claude-opus-5-5
JARVIS_USER_NAME=senhor
# Cidade usada no widget de clima e como padrão nas perguntas de tempo
JARVIS_CITY=Sorocaba

# --- Voz (ElevenLabs) ---
ELEVENLABS_API_KEY=
# ID da voz escolhida na biblioteca do ElevenLabs (estilo mordomo britânico, falando português)
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = resposta bem mais rápida | eleven_multilingual_v2 = voz um pouco mais rica, porém mais lenta
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Reconhecimento de fala ---
# tiny | base | small | medium | large-v3   (sem GPU: small; com GPU NVIDIA: medium ou large-v3)
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt
# auto = mlx no Mac Apple Silicon, faster-whisper nos demais (ou force: mlx | faster)
WHISPER_BACKEND=auto

# Modo conversa: por quantos minutos, depois de um comando, basta chamar "Jarvis" (sem "hey"). 0 = desligado
CONVERSATION_MINUTES=5
# Segundos logo após a resposta em que você pode falar sem dizer o nome
FOLLOW_UP_SECONDS=8
# Segundos de silêncio para considerar que você terminou de falar (menor = responde mais rápido)
SILENCE_SECONDS=0.6

# --- Hotword ---
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# --- Introdução do primeiro comando do dia ---
# Use UM dos dois: arquivo local (mp3/wav/flac/ogg) OU uma faixa do Spotify
INTRO_AUDIO_FILE=assets/intro.mp3
INTRO_SPOTIFY_URI=
# INTRO_SECONDS = duração máxima do trecho da música
INTRO_SECONDS=40
# Segundos de música sozinha antes da voz entrar
INTRO_LEAD_SECONDS=7
# Segundos de música ao fundo depois da saudação, antes do fade-out
INTRO_TAIL_SECONDS=1
# Volume da música enquanto o Jarvis fala (0 a 1)
INTRO_DUCK_LEVEL=0.25
# Volume da música de fundo depois do bipe (0 a 1) e por quantos segundos ela continua
INTRO_BED_LEVEL=0.10
INTRO_AFTER_SECONDS=10

# --- Spotify (https://developer.spotify.com/dashboard, Redirect URI: http://127.0.0.1:8888/callback) ---
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Tela HUD (interface futurista no navegador) ---
HUD=1
# Abrir o navegador sozinho ao iniciar (depois: Ctrl+Cmd+F para tela cheia)
HUD_AUTO_OPEN=1
# 127.0.0.1 = só neste computador. 0.0.0.0 = também no tablet, pela mesma rede Wi-Fi
HUD_HOST=127.0.0.1
HUD_PORT=8765
